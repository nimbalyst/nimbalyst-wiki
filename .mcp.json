{
  "mcpServers": {
    "nimbalyst-session": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@nimbalyst/cli@0.11.0",
        "hook",
        "session-inputs"
      ]
    },
    "nimbalyst-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@nimbalyst/cli@0.11.0",
        "mcp",
        "--plugin-root",
        "${CLAUDE_PLUGIN_ROOT}"
      ]
    }
  }
}
