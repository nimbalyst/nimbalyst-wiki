{
  "mcpServers": {
    "nimbalyst-session": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix",
        "/",
        "-y",
        "@nimbalyst/cli@0.12.2",
        "hook",
        "session-inputs"
      ]
    },
    "nimbalyst-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix",
        "/",
        "-y",
        "@nimbalyst/cli@0.12.2",
        "mcp",
        "--plugin-root",
        "${CLAUDE_PLUGIN_ROOT}"
      ]
    }
  }
}
